FROM rust:1.98.1 AS health_checker

ARG target=x86_64-unknown-linux-gnu
WORKDIR /build

COPY tools/http_health_checker/ ./http_health_checker/

RUN cd ./http_health_checker/ && \
    RUSTFLAGS='-C target-feature=+crt-static' \
    cargo build \
    --release \
    --target $target && \
    mv target/$target/release/http_health_checker /opt/http_health_checker && \
    chmod 555 /opt/http_health_checker

FROM rust:1.98.1 AS builder

ARG target=x86_64-unknown-linux-gnu

WORKDIR /build
RUN touch /opt/config.yml

# OpenSSL's static libcrypto.a references zlib (compression BIOs), so a
# fully static link needs libz.a available to resolve those symbols.
RUN apt-get update && \
    apt-get install -y --no-install-recommends zlib1g-dev && \
    rm -rf /var/lib/apt/lists/*

COPY tools/ ./tools/
COPY Cargo.toml ./Cargo.toml
COPY crates/ ./crates/


RUN RUSTFLAGS='-C target-feature=+crt-static' \
    cargo fetch
RUN RUSTFLAGS='-C target-feature=+crt-static -C link-arg=-l:libz.a' \
    cargo build \
    --release \
    --target $target \
    --bin backend && \
    mv target/$target/release/backend /opt/backend && \
    chmod 555 /opt/backend

FROM scratch

COPY --from=health_checker /opt/http_health_checker /http_health_checker
COPY --from=builder /opt/backend /backend
COPY --from=builder /opt/config.yml /etc/backend/config.yml
USER 10001
WORKDIR /

# API Server ; Prometheus /metrics ; Swagger UI
EXPOSE 9876 9100 7070

HEALTHCHECK \
    --start-period=5s \
    --interval=10s \
    --timeout=10s \
    --retries=3 \
    CMD [ "/http_health_checker", "http://127.0.0.1:9876/api/ping" ]
ENTRYPOINT [ "/backend", "--port", "9876", "--config", "/etc/backend/config.yml" ]
