# Rust builder used for static-web-server
FROM rust:1.98.1 AS rust_builder

ARG target=x86_64-unknown-linux-gnu
WORKDIR /build

RUN RUSTFLAGS='-C target-feature=+crt-static' \
    cargo install static-web-server --locked --root /opt/ --target $target

# Site builder used to compile the web application into an SPA
FROM oven/bun:1.3.14 AS site_builder
WORKDIR /usr/src/app
COPY frontend .
RUN bun vite build --outDir /dist

# Pre-compress the text assets so the server never has to compress a response.
# Uses Bun's bundled zlib rather than the `gzip`/`brotli` packages, keeping the
# build free of an apt dependency.
RUN bun scripts/compress-dist.ts /dist

# Final minimal image containing only static HTML/CSS/JS/Assets files
# and static-web-server to serve them.
FROM scratch

COPY --from=localhost/tmp_health_checker:latest /http_health_checker /bin/http_health_checker
COPY --from=rust_builder /opt/bin/static-web-server /bin/static-web-server
COPY --from=site_builder /dist /usr/app

USER 10001
WORKDIR /usr/app
EXPOSE 8080
HEALTHCHECK \
    --start-period=5s \
    --interval=10s \
    --timeout=10s \
    --retries=3 \
    CMD [ "/bin/http_health_checker", "http://127.0.0.1:8080/" ]
ENTRYPOINT ["/bin/static-web-server", \
    "--host", "0.0.0.0", "--port", "8080", "--root", "/usr/app", \
    "--compression-static", "true", \
    "--cache-control-headers", "true", \
    "--directory-listing", "false", \
    "--page-fallback", "/usr/app/index.html"]
