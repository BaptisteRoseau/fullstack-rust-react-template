{
    "name": "frontend",
    "version": "1.0.0",
    "private": true,
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build --base=/",
        "preview": "vite preview",
        "format": "prettier -w .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "prepare": "husky",
        "lint": "eslint src e2e",
        "check-types": "tsc --project tsconfig.json --pretty --noEmit",
        "generate": "plop",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "run-mock-server": "vite-node mock-server.ts | pino-pretty -c",
        "i18n:extract": "lingui extract --overwrite",
        "i18n:compile": "lingui compile",
        "i18n:check": "lingui extract --overwrite --clean && lingui compile --strict"
    },
    "dependencies": {
        "@hookform/resolvers": "^5",
        "@lingui/core": "^5",
        "@lingui/react": "5",
        "@ngneat/falso": "^8",
        "@radix-ui/react-dialog": "^1",
        "@radix-ui/react-dropdown-menu": "^2",
        "@radix-ui/react-label": "^2",
        "@radix-ui/react-slot": "^1",
        "@radix-ui/react-switch": "^1",
        "clsx": "^2",
        "dayjs": "^1",
        "eslint-plugin-check-file": "^3",
        "nanoid": "^5",
        "react": "^19",
        "react-dom": "^19",
        "react-error-boundary": "^6",
        "react-hook-form": "^7",
        "react-router": "8.0.0",
        "swr": "^2.5.0",
        "zod": "^4",
        "zustand": "^5"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/eslintrc": "^3",
        "@lingui/babel-plugin-lingui-macro": "^5.9.5",
        "@lingui/cli": "^5",
        "@lingui/vite-plugin": "^5",
        "@mswjs/data": "^0",
        "@mswjs/http-middleware": "^0",
        "@playwright/test": "^1",
        "@storybook/addon-a11y": "^10",
        "@storybook/addon-docs": "^10",
        "@storybook/addon-links": "^10",
        "@storybook/react-vite": "^10",
        "@testing-library/jest-dom": "^6",
        "@testing-library/react": "^16",
        "@testing-library/user-event": "^14",
        "@types/cors": "^2",
        "@types/express": "^5.0.6",
        "@types/node": "25.9.3",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^8",
        "@typescript-eslint/parser": "^8",
        "@vitejs/plugin-react": "^6",
        "@vitest/eslint-plugin": "^1",
        "cors": "^2",
        "eslint": "^9",
        "eslint-config-prettier": "^10",
        "eslint-import-resolver-typescript": "^4",
        "eslint-plugin-import": "^2",
        "eslint-plugin-jest-dom": "^5",
        "eslint-plugin-jsx-a11y": "^6",
        "eslint-plugin-playwright": "^2",
        "eslint-plugin-prettier": "^5",
        "eslint-plugin-react": "^7",
        "eslint-plugin-react-hooks": "^7",
        "eslint-plugin-storybook": "10.4.6",
        "eslint-plugin-testing-library": "^7",
        "express": "5.2.1",
        "husky": "^9",
        "jest-environment-jsdom": "^30",
        "jsdom": "29.1.1",
        "lint-staged": "^17",
        "msw": "^2",
        "pino-http": "^11",
        "pino-pretty": "^13",
        "plop": "^4",
        "prettier": "^3",
        "sass-embedded": "^1.100.0",
        "storybook": "^10",
        "typescript": "^6",
        "vite": "^8",
        "vite-node": "^6",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^4"
    },
    "msw": {
        "workerDirectory": "public"
    },
    "lint-staged": {
        "*.+(ts|tsx)": [
            "bun lint",
            "bash -c 'bun check-types'"
        ]
    }
}
