{
    "name": "frontend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build --base=/",
        "preview": "vite preview",
        "format": "prettier -w .",
        "test": "vitest",
        "test-e2e": "pm2 start \"bun run run-mock-server\" --name server && bunx playwright test",
        "prepare": "husky",
        "lint": "eslint src",
        "check-types": "tsc --project tsconfig.json --pretty --noEmit",
        "generate": "plop",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "run-mock-server": "vite-node mock-server.ts | pino-pretty -c",
        "i18n:extract": "lingui extract --overwrite",
        "i18n:compile": "lingui compile",
        "i18n:check": "lingui extract --overwrite --clean && lingui compile --strict"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.4.0",
        "@lingui/core": "^6.4.0",
        "@lingui/macro": "^5.9.5",
        "@lingui/react": "6.4.0",
        "@ngneat/falso": "^8.0.2",
        "@radix-ui/react-dialog": "^1.1.17",
        "@radix-ui/react-dropdown-menu": "^2.1.18",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-label": "^2.1.10",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-switch": "^1.3.1",
        "@tailwindcss/vite": "^4.3.1",
        "@tanstack/react-query": "^5.101.0",
        "@tanstack/react-query-devtools": "^5.101.0",
        "axios": "^1.18.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.21",
        "dompurify": "^3.4.11",
        "eslint-plugin-check-file": "^3.3.1",
        "lucide-react": "^1.20.0",
        "marked": "^18.0.5",
        "nanoid": "^5.1.11",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-error-boundary": "^6.1.2",
        "react-helmet-async": "^3.0.0",
        "react-hook-form": "^7.79.0",
        "react-query-auth": "^2.4.3",
        "react-router": "^7.18.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.5",
        "@lingui/cli": "^6.4.0",
        "@lingui/vite-plugin": "^6.4.0",
        "@mswjs/data": "^0.16.2",
        "@mswjs/http-middleware": "^0.10.3",
        "@playwright/test": "^1.61.0",
        "@storybook/addon-a11y": "^10.4.6",
        "@storybook/addon-links": "^10.4.6",
        "@storybook/react-vite": "^10.4.6",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/cors": "^2.8.19",
        "@types/dompurify": "^3.2.0",
        "@types/js-cookie": "^3.0.6",
        "@types/marked": "^5.0.2",
        "@types/node": "^25.9.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.61.1",
        "@typescript-eslint/parser": "^8.61.1",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/eslint-plugin": "^1.6.20",
        "autoprefixer": "^10.5.0",
        "cors": "^2.8.6",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest-dom": "^5.5.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-playwright": "^2.10.4",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-tailwindcss": "^3.18.3",
        "eslint-plugin-testing-library": "^7.16.2",
        "express": "^5.2.1",
        "husky": "^9.1.7",
        "jest-environment-jsdom": "^30.4.1",
        "js-cookie": "^3.0.8",
        "jsdom": "^29.1.1",
        "lint-staged": "^17.0.7",
        "msw": "^2.14.6",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "plop": "^4.0.5",
        "pm2": "^7.0.1",
        "postcss": "^8.5.15",
        "prettier": "^3.8.4",
        "storybook": "^10.4.6",
        "tailwindcss": "^4.3.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.16",
        "vite-node": "^6.0.0",
        "vitest": "^4.1.9",
        "eslint-plugin-storybook": "10.4.6",
        "@storybook/addon-docs": "^10.4.6"
    },
    "msw": {
        "workerDirectory": "public"
    },
    "lint-staged": {
        "*.+(ts|tsx)": [
            "bun lint",
            "bash -c 'bun check-types'"
        ]
    }
}
