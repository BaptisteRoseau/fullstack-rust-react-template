{
    "name": "frontend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build --base=/",
        "preview": "vite preview",
        "format": "prettier -w .",
        "test": "vitest",
        "test:e2e": "pm2 start \"bun run run-mock-server\" --name server && bunx playwright test",
        "prepare": "husky",
        "lint": "eslint src",
        "check-types": "tsc --project tsconfig.json --pretty --noEmit",
        "generate": "plop",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "run-mock-server": "vite-node mock-server.ts | pino-pretty -c",
        "i18n:extract": "lingui extract --overwrite",
        "i18n:compile": "lingui compile",
        "i18n:check": "lingui extract --overwrite --clean && lingui compile --strict"
    },
    "dependencies": {
        "@hookform/resolvers": "^5",
        "@lingui/core": "^5",
        "@lingui/react": "5",
        "@ngneat/falso": "^8",
        "@radix-ui/react-dialog": "^1",
        "@radix-ui/react-dropdown-menu": "^2",
        "@radix-ui/react-icons": "^1",
        "@radix-ui/react-label": "^2",
        "@radix-ui/react-slot": "^1",
        "@radix-ui/react-switch": "^1",
        "@tailwindcss/vite": "^4",
        "@tanstack/react-query": "^5",
        "@tanstack/react-query-devtools": "^5",
        "axios": "^1",
        "class-variance-authority": "^0",
        "clsx": "^2",
        "dayjs": "^1",
        "dompurify": "3.4.11",
        "eslint-plugin-check-file": "^3",
        "lucide-react": "^1",
        "marked": "^18",
        "nanoid": "^5",
        "react": "^19",
        "react-dom": "^19",
        "react-error-boundary": "^6",
        "react-helmet-async": "^3",
        "react-hook-form": "^7",
        "react-query-auth": "^2",
        "react-router": "8.0.0",
        "tailwind-merge": "^3",
        "tailwindcss-animate": "^1",
        "zod": "^4",
        "zustand": "^5"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@lingui/cli": "^5",
        "@lingui/vite-plugin": "^5",
        "@mswjs/data": "^0",
        "@mswjs/http-middleware": "^0",
        "@playwright/test": "^1",
        "@storybook/addon-a11y": "^10",
        "@storybook/addon-docs": "^10",
        "@storybook/addon-links": "^10",
        "@storybook/react-vite": "^10",
        "@tailwindcss/typography": "^0",
        "@testing-library/jest-dom": "^6",
        "@testing-library/react": "^16",
        "@testing-library/user-event": "^14",
        "@types/cors": "^2",
        "@types/dompurify": "^3",
        "@types/js-cookie": "^3",
        "@types/marked": "6.0.0",
        "@types/node": "25.9.3",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^8",
        "@typescript-eslint/parser": "^8",
        "@vitejs/plugin-react": "^6",
        "@vitest/eslint-plugin": "^1",
        "autoprefixer": "^10",
        "cors": "^2",
        "eslint": "^9",
        "eslint-config-prettier": "^10",
        "eslint-import-resolver-typescript": "^4",
        "eslint-plugin-import": "^2",
        "eslint-plugin-jest-dom": "^5",
        "eslint-plugin-jsx-a11y": "^6",
        "eslint-plugin-playwright": "^2",
        "eslint-plugin-prettier": "^5",
        "eslint-plugin-react": "^7",
        "eslint-plugin-react-hooks": "^7",
        "eslint-plugin-storybook": "10.4.6",
        "eslint-plugin-tailwindcss": "^3",
        "eslint-plugin-testing-library": "^7",
        "express": "5.2.1",
        "husky": "^9",
        "jest-environment-jsdom": "^30",
        "js-cookie": "^3",
        "jsdom": "29.1.1",
        "lint-staged": "^17",
        "msw": "^2",
        "pino-http": "^11",
        "pino-pretty": "^13",
        "plop": "^4",
        "pm2": "^7",
        "postcss": "^8",
        "prettier": "^3",
        "storybook": "^10",
        "tailwindcss": "^4",
        "typescript": "^6",
        "vite": "^8",
        "vite-node": "^6",
        "vitest": "^4"
    },
    "msw": {
        "workerDirectory": "public"
    },
    "lint-staged": {
        "*.+(ts|tsx)": [
            "bun lint",
            "bash -c 'bun check-types'"
        ]
    }
}
