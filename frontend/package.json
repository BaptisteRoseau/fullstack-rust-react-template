{
    "name": "frontend",
    "version": "1.0.0",
    "private": true,
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build --base=/",
        "preview": "vite preview",
        "format": "prettier -w .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "prepare": "husky",
        "lint": "eslint src e2e",
        "check-types": "tsc --project tsconfig.json --pretty --noEmit",
        "generate": "plop",
        "storybook": "storybook dev -p 6006",
        "storybook:build": "storybook build",
        "run-mock-server": "vite-node mock-server.ts | pino-pretty -c",
        "seo:generate": "vite-node scripts/generate-seo-files.cli.ts",
        "seo:check": "vitest run scripts/generate-seo-files.test.ts",
        "api:sdk": "vite-node scripts/generateApiSdk.ts",
        "api:check": "vite-node scripts/generateApiSdk.ts --check",
        "i18n:extract": "lingui extract --overwrite",
        "i18n:compile": "lingui compile",
        "i18n:check": "lingui extract --overwrite --clean && lingui compile --strict"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "@lingui/core": "^5.9.5",
        "@lingui/react": "^5.9.5",
        "@ngneat/falso": "^8.0.2",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-dropdown-menu": "^2.1.24",
        "@radix-ui/react-label": "^2.1.15",
        "@radix-ui/react-slot": "^1.3.3",
        "@radix-ui/react-switch": "^1.3.7",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.23",
        "eslint-plugin-check-file": "^3.3.2",
        "nanoid": "^6.0.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-error-boundary": "^6.1.3",
        "react-hook-form": "^7.86.0",
        "react-router": "8.3.0",
        "swr": "^2.5.1",
        "zod": "^4.4.3",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/eslintrc": "^3.3.6",
        "@hey-api/openapi-ts": "^0.99.0",
        "@lingui/babel-plugin-lingui-macro": "^5.9.5",
        "@lingui/cli": "^5.9.5",
        "@lingui/format-po": "^5.9.5",
        "@lingui/vite-plugin": "^5.9.5",
        "@msw/data": "^1.1.7",
        "@mswjs/http-middleware": "^0.10.3",
        "@playwright/test": "^1.62.1",
        "@storybook/addon-a11y": "^10.5.10",
        "@storybook/addon-docs": "^10.5.10",
        "@storybook/addon-links": "^10.5.10",
        "@storybook/react-vite": "^10.5.10",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "25.9.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "@vitejs/plugin-react": "^6.1.0",
        "@vitest/eslint-plugin": "^1.6.27",
        "cors": "^2.8.6",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-css-modules": "^2.12.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest-dom": "^5.10.1",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "10.4.6",
        "eslint-plugin-testing-library": "^7.16.2",
        "express": "5.2.1",
        "husky": "^9.1.7",
        "jest-environment-jsdom": "^30.4.1",
        "jsdom": "29.1.1",
        "lint-staged": "^17.3.0",
        "msw": "^2.15.0",
        "pino-http": "^11.0.0",
        "pino-pretty": "^13.1.3",
        "plop": "^4.0.5",
        "prettier": "^3.9.6",
        "sass-embedded": "^1.103.1",
        "storybook": "^10.5.10",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vite-node": "^6.0.0",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^4.1.11"
    },
    "msw": {
        "workerDirectory": "public"
    },
    "lint-staged": {
        "*.+(ts|tsx)": [
            "bun lint",
            "bash -c 'bun check-types'"
        ]
    }
}
