# Set to true to serve the API from the MSW mock handlers instead of the backend
# at VITE_APP_API_URL. Note that the OIDC login flow is a top-level navigation to
# the backend, which a service worker cannot intercept, so mocked mode cannot log
# a real session in: it is for developing screens without a backend, not for auth.
VITE_APP_API_URL=http://localhost:8080
VITE_APP_ENABLE_API_MOCKING=false
