import { Spinner } from '@/components/ui/spinner'

import { use{{properCase name}} } from '../api/get-{{kebabCase name}}'

export const {{properCase name}}List = () => {
    const query = use{{properCase name}}()

    if (query.isLoading) {
        return (
            <div className="flex h-48 w-full items-center justify-center">
                <Spinner size="lg" />
            </div>
        )
    }

    return <div>{{properCase name}}List</div>
}
