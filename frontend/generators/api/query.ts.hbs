import { queryOptions, useQuery } from '@tanstack/react-query'

import { api } from '@/lib/api-client'
import { QueryConfig } from '@/lib/react-query'

export const get{{properCase noun}} = (): Promise<{ data: unknown[] }> => {
    return api.get(`/{{kebabCase noun}}`)
}

export const get{{properCase noun}}QueryOptions = () => {
    return queryOptions({
        queryKey: ['{{kebabCase noun}}'],
        queryFn: get{{properCase noun}},
    })
}

type Use{{properCase noun}}Options = {
    queryConfig?: QueryConfig<typeof get{{properCase noun}}QueryOptions>
}

export const use{{properCase noun}} = ({ queryConfig }: Use{{properCase noun}}Options = {}) => {
    return useQuery({
        ...get{{properCase noun}}QueryOptions(),
        ...queryConfig,
    })
}
