import { act, renderHook } from '@testing-library/react'

import { use{{pascalCase name}} } from './use{{pascalCase name}}'

it('resets to its initial value', () => {
    const { result } = renderHook(() => use{{pascalCase name}}('initial'))

    act(() => result.current.setValue('changed'))
    act(() => result.current.reset())

    expect(
        result.current.value,
        `expected "initial", got "${result.current.value}"`,
    ).toBe('initial')
})
